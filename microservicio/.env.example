# .env de ejemplo del microservicio de campo (§8 del contrato).
# Copia a `.env` en el servidor y rellena los secretos. NO lo subas al repo.

# Token Bearer que exige la API (y el WebSocket por ?token=). Generalo con:
#   openssl rand -hex 24
CAMPO_TOKEN=pon-aqui-un-token-largo-y-secreto

# --- MQTT (solo lectura de uplinks) ---
MQTT_HOST=mqtt.pi-caro.org
MQTT_PORT=8883
MQTT_USER=picaro
MQTT_PASSWORD=pon-aqui-la-contrasena-mqtt
MQTT_TLS=true

# --- API REST de ChirpStack (cambio de perfil + encolar ping) ---
CHIRPSTACK_API=https://api.pi-caro.org
# Token de la API de ChirpStack (documentacion interna de infraestructura)
CHIRPSTACK_TOKEN=pon-aqui-el-token-de-la-api-de-chirpstack

# --- IDs de device profile de ChirpStack (cambio de perfil por corrida) ---
# Son los mismos que usa servidor/perfil.py. Sin ellos, el cambio de perfil falla.
PROFILE_ID_EJ09=<PROFILE_ID_EJ09>
PROFILE_ID_TERRENO_A=<PROFILE_ID_TERRENO_A>
PROFILE_ID_TERRENO_C=<PROFILE_ID_TERRENO_C>
PROFILE_ID_RADIOSONDA_C=<PROFILE_ID_RADIOSONDA_C>

# --- Device del experimento (reutilizado del ej.09) ---
APP_ID=<APP_ID>
DEV_EUI=0011223344550001
# Segunda sonda, la T3 / LoRa32 (D-65): solo corre VUELO-A. Vacio = no configurada.
DEV_EUI_LORA32=0011223344550003
# Sonda radiosonda (docs/RADIOSONDA-ESPEC.md): solo corre RADIOSONDA-C. Es la
# misma T-Beam con otro firmware, asi que hoy lleva el MISMO valor que DEV_EUI.
# Vacio = no configurada (la app no podra abrir RADIOSONDA-C).
DEV_EUI_RADIOSONDA=

# --- Almacenamiento (volumen persistente del contenedor) ---
DB_PATH=/data/campo.db

# --- Posicion del gateway, para la distancia haversine de las metricas ---
# Sin estas dos, dist_gw_km_max sale null (no 0).
GW_LAT=
GW_LON=

# --- Objetivo de uplinks por corrida (auto-finaliza al alcanzarlo) ---
# Vale para las corridas URBANO/TERRAZA/CERRO16. VUELO fija el suyo (165) en
# config.py y no lo lee de aqui.
TARGET_UPLINKS=300

# --- Ping automatico ligado a la sesion (D-61) ---
# Cadencia en segundos del ping fPort 98 mientras una sesion captura.
# 0 lo desactiva (quedan solo los pings manuales de /ping).
PING_INTERVAL_S=60
