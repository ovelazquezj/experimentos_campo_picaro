# Copiar a .env (permisos 600) en /opt/picaro-mapa/ y rellenar.

# Usuario MQTT de SOLO LECTURA (ACL: read application/+/device/+/event/up)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=picaro-mapa
MQTT_PASS=

# Rol Postgres de solo lectura por columnas (ver README, "Rol de Postgres")
PG_DSN=host=postgres dbname=chirpstack user=picaro_mapa password=

# Tenant "Proyecto PiCARO"
TENANT_ID=<uuid del tenant Proyecto PiCARO>

# Secreto para los IDs publicos opacos: openssl rand -hex 32
# Si cambia, los IDs cambian y el historial guardado queda huerfano.
ID_SECRET=

# Ubicacion por defecto (ITPA). Tomada del gateway ITPA-IOT-GW01-kibts.
ITPA_LAT=22.161428
ITPA_LON=-102.269043

HISTORIAL_DIAS=7
CATALOGO_SEG=60
